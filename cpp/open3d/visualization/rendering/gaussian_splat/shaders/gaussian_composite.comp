// 2D Gaussian surfel composite pass.
//
// Pixels select surfel intersections by actual ray depth within each tile.
// Transparent surfaces composite front-to-back. Opaque ownership follows
// reference Gaussian coverage, then normal/albedo weights reconstruct only
// that surface. Center-depth keys only group candidate splats by tile.
//
// Compiled with glslangValidator -V --target-env vulkan1.3 (Vulkan SPIR-V).
// Image binding 16 is used for out_color (instead of the natural 0) to avoid
// a Vulkan descriptor-set conflict: UBO GaussianViewParams is at binding 0 in
// set 0, and Vulkan does not allow a second descriptor type at the same
// (set, binding) pair.  All GL/Metal backends pass Image(16,...) to match.
//
// Opt1: Zero-copy output — the VkImage written here is imported directly
//       into Filament via Texture::Builder::import(), eliminating the
//       staging-buffer round-trip.
// Opt4b: ProjectedComposite (104 B, binding 6) stores color, three
//        projective/depth rows and four FP32 clipping angle/split values.
//        The conic center and boundary normals are computed cooperatively.
// Opt7: Shared-memory cooperative tile loading — the workgroup loads batches
//       of splat data into shared memory, then all 256 threads evaluate from
//       shared memory instead of 256 independent global reads.
// Opt8: Compact sorted payload — binding 11 is now uint[] splat_index values
//       (4 B each) instead of TileEntry structs (12 B each), reducing the
//       sorted payload buffer size by 3× and halving memory bandwidth here.
// Opt9: Work-stealing persistent threads — each workgroup atomically claims
//       tiles from a global counter until all tiles are processed.  Eliminates
//       the tile's entry range is found with a O(log N) binary search on the
//       sorted keys (binding 7). Load balancing: workgroups that finish light
//       tiles immediately claim new ones, keeping all SMs busy throughout
//       frame.

#version 460

#extension GL_GOOGLE_include_directive : require
#include "gaussian_ray_intersection.glsl"

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Composite-pass projected 2D surfel data (104 B, binding 6).
// This layout must exactly match gaussian_project.comp and the C++
// ProjectedComposite structure in GaussianSplatDataPacking.h.
struct ProjectedComposite {
    // vec2 pairs retain FP32 projective/depth rows without vec4 padding.
    vec2 row_x_xy;
    vec2 row_x_zw;
    vec2 row_y_xy;
    vec2 row_y_zw;
    vec2 row_w_xy;
    vec2 row_w_zw;
    // Four consecutive FP32 values; inactive angle = 4, split = 0.
    vec2 clip1_angle_split;
    vec2 clip2_angle_split;
    uint surface_id;
    uint surface_flags;
    vec2 surface_normal_xy;
    vec2 surface_normal_z_sigma;
    vec2 surface_color_rg;
    vec2 surface_color_b_reserved;
};

layout(std140, binding = 0) uniform GaussianViewParams {
    mat4 world_from_model;
    mat4 view_from_world;
    mat4 clip_from_view;
    vec4 camera_position_and_near;
    vec4 viewport_origin_and_size;
    uvec4 scene;
    uvec4 tiles;
    uvec4 limits;
    vec4 depth_range_and_flags;
    // One Phong triple for every GS; w is reserved and zero.
    vec4 surface_lighting;
}
view_params;

layout(std430, binding = 6) restrict readonly buffer ProjectedComposites {
    ProjectedComposite composite[];
};

// All surfel intersection data is in ProjectedComposite; no binding 13.

// Sorted sort keys from the final radix-sort pass (same buffer as project
// output).  Used for binary search to find each tile's entry range, replacing
// Binary search on sort_keys finds each tile's entry range (binding 7).
// Key format: upper T bits = tile_index, lower D bits = depth component,
// where T = limits.w, D = 32 - T.
layout(std430, binding = 7) restrict readonly buffer SortKeys {
    uint sort_keys[];
};

// Work-stealing counter: one uint32 cleared to 0 before each composite pass.
// Thread 0 of each workgroup atomically claims the next tile index.
layout(std430, binding = 8) restrict buffer StealCounter {
    uint steal_counter;
};

// Global counters from the geometry pass: total_entries is the number of
// sort entries produced (before entry_capacity clamping is applied).
layout(std430, binding = 10) restrict readonly buffer GaussianGlobalCounters {
    uint total_entries;
    uint error_flags;
    uint tile_count_gs;  // tile count as seen by the geometry pass
    uint splat_count_gs;
}
gs_counters;

// Compact sorted payload: one splat_index per tile entry, in sort order.
// Only splat_index is needed here; depth_key and tile_index were used by
// the radix sort keygen and are not read during compositing.
layout(std430, binding = 11) restrict readonly buffer SortedSplatIndices {
    uint sorted_splat_indices[];
};

// Image bindings must be < GL_MAX_IMAGE_UNITS (8 on many drivers).
// These two output images use units 0 and 1; SSBO/UBO/sampler bindings
// above live in separate namespaces and are not affected.
// Binding 16 avoids the (set=0, binding=0) conflict with GaussianViewParams
// UBO.
layout(binding = 16, rgba16f) uniform image2D out_color;
layout(binding = 1, r32f) uniform writeonly image2D out_depth;

// Scene depth from Filament's render pass (reversed-Z, non-linear).
// Bound only when depth_range_and_flags.w > 0.5.
layout(binding = 14) uniform sampler2D scene_depth;

const float kLog2E = 1.44269504089;  // log2(e) for exp2-based Gaussian
const float kSurfelCutoffSq = 9.0;   // 3-sigma local cutoff
const float kFilterInvSquare = 2.0;  // FilterSize = 1 / sqrt(2)
const float kIntersectionEpsilon = 1e-8;

uvec2 GetTileSize() { return max(view_params.tiles.xy, uvec2(1u)); }

uvec2 GetTileCount2D() { return max(view_params.tiles.zw, uvec2(1u)); }

ivec2 GetViewportSize() {
    return ivec2(max(view_params.viewport_origin_and_size.zw, vec2(1.0)));
}

uint LinearTileIndex(uvec2 tile) {
    uvec2 tile_count = GetTileCount2D();
    return tile.y * tile_count.x + tile.x;
}

// Morton curve helpers: decode a Z-order (Morton) code to 2D tile (x, y).
// Even bit positions carry x; odd bit positions carry y.
// Neighboring tiles in Morton order share cache lines in the sorted splat
// buffer more often than raster order, improving L2 hit rate.
//
// MortonExtractEvenBits: compact all even-position bits to the low end.
uint MortonExtractEvenBits(uint x) {
    x &= 0x55555555u;
    x = (x ^ (x >> 1u)) & 0x33333333u;
    x = (x ^ (x >> 2u)) & 0x0f0f0f0fu;
    x = (x ^ (x >> 4u)) & 0x00ff00ffu;
    x = (x ^ (x >> 8u)) & 0x0000ffffu;
    return x;
}

uvec2 MortonDecode2D(uint code) {
    return uvec2(MortonExtractEvenBits(code),         // x: even bits
                 MortonExtractEvenBits(code >> 1u));  // y: odd bits
}

// Round x up to the next power-of-2 (≥1).
uint NextPow2(uint x) {
    if (x <= 1u) return 1u;
    // findMSB returns the index of the most significant 1-bit
    return 1u << (findMSB(x - 1u) + 1u);
}

// Binary search: return the first index i in [lo, hi) such that
// (sort_keys[i] >> D) >= target_tile.  Sort keys are sorted ascending so
// tile indices occupy the most-significant T bits (T = 32 - D).
// Caller supplies [lo, hi) so the second of two adjacent-tile searches can
// start from the first result, reducing cost from O(log₂ N) to O(log₂ n)
// where n is the number of entries in that tile.
uint LowerBound(uint target_tile, uint lo, uint hi, uint D) {
    while (lo < hi) {
        uint mid = lo + ((hi - lo) >> 1u);
        if ((sort_keys[mid] >> D) < target_tile) {
            lo = mid + 1u;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// Convert Filament's infinite-far reversed depth (near=1, infinity=0) to
// normalized linear depth (near=0, far=1) using the finite culling far plane.
// Filament's render projection stores inv = near / d, so:
//   linear_01 = (d - near) / (far - near)
//              = near * (1 - inv) / (inv * (far - near))
float InverseToLinear01(float inv, float near, float far) {
    if (inv <= 0.0) return 1.0;
    return clamp(near * (1.0 - inv) / (inv * (far - near)), 0.0, 1.0);
}

// Convert normalized linear depth (near=0, far=1) back to Filament's
// infinite-far reversed depth (near=1, infinity=0).
// Formula: inv = near / (near + linear_01 * (far - near))
float Linear01ToInverse(float linear_01, float near, float far) {
    return near / (near + clamp(linear_01, 0.0, 1.0) * (far - near));
}

// Opt7: Shared memory arrays for cooperative tile loading.
// 256 entries x 88 logical bytes, plus 16 B of work-stealing state below.
// Backend workgroup-memory layout may add padding to the vec3 arrays.
const uint BATCH_SIZE = 256u;
shared vec2 s_center[BATCH_SIZE];
shared uint s_index[BATCH_SIZE];
shared uint s_flags[BATCH_SIZE];
shared vec4 s_row_x_depth_u[BATCH_SIZE];
shared vec4 s_row_y_depth_v[BATCH_SIZE];
shared vec4 s_row_w_depth_c[BATCH_SIZE];
// Boundary normals exist only in transient workgroup memory: trig runs once
// per splat/batch, not per pixel, without enlarging persistent attributes.
shared vec3 s_clip1[BATCH_SIZE];
shared vec3 s_clip2[BATCH_SIZE];

// Opt9: Work-stealing shared state.
// s_stolen_tile: tile index claimed atomically from steal_counter by thread 0.
// wg_tile_offset/wg_tile_count: tile range found by binary search (thread 0),
// broadcast to all threads.
// wg_active_count: pixels that need another sorted-hit round. Every lane
// participates in shared-memory barriers until all pixels finish.
shared uint s_stolen_tile;
shared uint wg_tile_count;
shared uint wg_tile_offset;
shared uint wg_active_count;

// Convert a validated angle/split pair to a transient half-plane. Inactive
// angle 4 produces an always-passing condition, including for off-center UVs.
vec3 ClipNormalSplit(vec2 angle_split) {
    const float kPi = 3.14159265358979323846;
    if (angle_split.x >= -kPi && angle_split.x < kPi) {
        return vec3(cos(angle_split.x), sin(angle_split.x), angle_split.y);
    }
    return vec3(0.0, 0.0, -1.0);
}

// Load one candidate per lane. All callers synchronize before using the batch.
void LoadCandidate(uint entry_offset, uint local_index) {
    uint entry_idx = entry_offset + local_index;
    uint splat_idx = sorted_splat_indices[entry_idx];
    ProjectedComposite g = composite[splat_idx];
    s_flags[local_index] = g.surface_flags;
    s_index[local_index] = splat_idx;
    s_row_x_depth_u[local_index] = vec4(g.row_x_xy, g.row_x_zw);
    s_row_y_depth_v[local_index] = vec4(g.row_y_xy, g.row_y_zw);
    s_row_w_depth_c[local_index] = vec4(g.row_w_xy, g.row_w_zw);
    s_clip1[local_index] = ClipNormalSplit(g.clip1_angle_split);
    s_clip2[local_index] = ClipNormalSplit(g.clip2_angle_split);

    // Reconstruct the same projected conic center produced by
    // ComputeSurfelAabb() in gaussian_project.comp. This preserves
    // the existing screen-space low-pass filter exactly without
    // storing a redundant center in the projected GPU buffer.
    vec3 row_x = vec3(g.row_x_xy, g.row_x_zw.x);
    vec3 row_y = vec3(g.row_y_xy, g.row_y_zw.x);
    vec3 row_w = vec3(g.row_w_xy, g.row_w_zw.x);
    vec3 conic = vec3(kSurfelCutoffSq,
                      kSurfelCutoffSq,
                      -1.0);
    float denominator = dot(conic, row_w * row_w);
    vec3 f = conic / denominator;
    s_center[local_index] =
            vec2(dot(f, row_x * row_w),
                 dot(f, row_y * row_w));
}


// The reconstruction pass shares precisely the legacy intersection, support,
// two-edge clipping and scene-depth tests. All splats use fixed opacity;
// opaque interpolation uses G while reference coverage uses 0.99 * G.
bool EvaluateCandidate(uint i, vec2 pixel_center, bool use_scene_depth,
                       float scene_linear_01, float near, float far,
                       out float linear_depth, out float alpha) {
    const float kMinAlpha = 1.0 / 255.0;
    bool opaque = (s_flags[i] & 1u) != 0u;
    vec4 row_x_depth_u = s_row_x_depth_u[i];
    vec4 row_y_depth_v = s_row_y_depth_v[i];
    vec4 row_w_depth_c = s_row_w_depth_c[i];

    vec2 local_uv;
    if (!GaussianRayLocalUV(pixel_center, row_x_depth_u.xyz,
                            row_y_depth_v.xyz, row_w_depth_c.xyz,
                            kIntersectionEpsilon, local_uv)) {
        return false;
    }

    // Reject before Gaussian evaluation or any color/depth
    // contribution. The accepted boundary is dot(n,uv) >= split.
    if (GaussianRayOutsideClip(local_uv, s_clip1[i].xyz) ||
        GaussianRayOutsideClip(local_uv, s_clip2[i].xyz)) {
        return false;
    }

    // Gaussian distance on the actual surfel plane.
    float rho_surface = dot(local_uv, local_uv);

    // Screen-space low-pass filter for sub-pixel surfels.
    vec2 delta_pixels = pixel_center - s_center[i];
    float rho_screen =
            kFilterInvSquare * dot(delta_pixels, delta_pixels);
    float rho = min(rho_surface, rho_screen);
    if (rho > kSurfelCutoffSq) {
        return false;
    }

    // Evaluate the actual view-space depth at this pixel.
    linear_depth = GaussianRayDepth(local_uv, row_x_depth_u.w,
                                    row_y_depth_v.w, row_w_depth_c.w);

    // Also rejects NaN because comparisons with NaN are false.
    if (!(linear_depth > near && linear_depth < far)) {
        return false;
    }

    float pixel_norm_depth =
            (linear_depth - near) / (far - near);

    // A tilted surfel has different depth at every pixel, so
    // mesh occlusion must be tested after ray-surfel
    // intersection rather than with the splat center depth.
    if (use_scene_depth &&
        pixel_norm_depth >= scene_linear_01) {
        return false;
    }

    // Gaussian support and the transparent cutoff remain unchanged. Opaque
    // reconstruction needs G itself; reference coverage multiplies it by 0.99.
    float power = -0.5 * rho;
    alpha = exp2(power * kLog2E) * (opaque ? 1.0 : 0.99);
    if (!(alpha > 0.0) || (!opaque && alpha < kMinAlpha)) {
        return false;
    }
    return true;
}


// Both solid and weak-support reconstruction use the identical view ray,
// surface compatibility and shading rules. Neither stage modifies geometry.
vec3 SurfaceViewRay(vec2 pixel_center, uvec2 viewport_size) {
    vec3 ray = vec3(0.0, 0.0, -1.0);
    if (abs(view_params.clip_from_view[3][3]) < 0.5) {
        vec2 ndc = 2.0 * pixel_center / vec2(viewport_size) - 1.0;
        if (view_params.scene.w != 0u) ndc.y = -ndc.y;
        ray = normalize((inverse(view_params.clip_from_view) *
                         vec4(ndc, 0.0, 1.0)).xyz);
    }
    return ray;
}

// Add only locally compatible samples of this physical surface. Coverage is
// separate: Gaussian G weights shading, while 0.99 * G determines coverage.
void AccumulateSurface(ProjectedComposite anchor, float anchor_depth,
                       ProjectedComposite candidate, float candidate_depth,
                       float weight, vec3 ray, inout vec3 normal_sum,
                       inout vec3 color_sum,
                       inout float weight_sum) {
    if (candidate.surface_id != anchor.surface_id) return;
    vec3 anchor_normal = vec3(anchor.surface_normal_xy,
                              anchor.surface_normal_z_sigma.x);
    vec3 normal = vec3(candidate.surface_normal_xy,
                       candidate.surface_normal_z_sigma.x);
    if (dot(normal, anchor_normal) < 0.866025403784) return;
    float slab = 0.5 * anchor.surface_normal_z_sigma.y;
    float ray_normal_per_z = abs(dot(anchor_normal, ray)) / max(abs(ray.z), 1e-8);
    if (abs(candidate_depth - anchor_depth) * ray_normal_per_z > slab) return;
    normal_sum += weight * normal;
    color_sum += weight * vec3(candidate.surface_color_rg,
                               candidate.surface_color_b_reserved.x);
    weight_sum += weight;
}

// One Phong headlight for both modes: a single GS or compatible weighted data.
// Shading never changes the selected surface or its actual intersection depth.
vec3 ShadeSurface(vec3 normal_sum, vec3 color_sum,
                  float weight_sum, vec3 ray) {
    vec3 normal = normalize(normal_sum / weight_sum);
    vec3 color = color_sum / weight_sum;
    vec3 lighting = view_params.surface_lighting.xyz;
    float cosine = max(dot(normal, -ray), 0.0);
    // Preserve the original arithmetic at the default exponent. Larger
    // exponents narrow the shared camera-facing specular highlight. Clamp
    // roundoff above one so large finite exponents cannot overflow.
    float shininess = view_params.surface_lighting.w;
    float specular = shininess == 2.0 ? lighting.z * cosine * cosine
                                     : lighting.z * (cosine > 0.0
                                               ? pow(min(cosine, 1.0), shininess)
                                               : 0.0);
    return clamp(color * (lighting.x + lighting.y * cosine) +
                 vec3(specular), 0.0, 1.0);
}

void main() {
    const float kSurfaceThreshold =
            0.5;  // Declare surface when transmittance hits this value.
    const float kMinTransmittance =
            1.0 /
            4096.0;  // Stop compositing when transmittance hits this value.

    uint local_index = gl_LocalInvocationIndex;  // 0..255 for 16×16

    // Pre-compute uniform values read each iteration.
    uvec2 tile_size = GetTileSize();
    uvec2 tile_count_2d = GetTileCount2D();
    ivec2 viewport_size = GetViewportSize();
    // Morton range: the steal_counter scans Z-curve codes from 0 to
    // morton_range-1.  The side length is the next power-of-2 >= both tile
    // grid dimensions; squaring it gives the number of Morton codes to visit.
    // Codes whose decoded (tx, ty) falls outside the grid are skipped with a
    // uniform continue — this only happens for non-power-of-2 grids and adds
    // at most 2× extra atomicAdd calls (no per-pixel work).
    uint morton_side = NextPow2(max(tile_count_2d.x, tile_count_2d.y));
    uint morton_range = morton_side * morton_side;
    // D = bits reserved for the depth component in each sort key.
    // T = limits.w = ceil(log2(tile_count)); D = 32 - T.
    uint D = 32u - view_params.limits.w;
    // Total valid sort entries, capped at the configured capacity.
    uint N = min(gs_counters.total_entries, view_params.limits.x);

    float near = view_params.depth_range_and_flags.x;
    float far = view_params.depth_range_and_flags.y;
    bool composite_over_base = view_params.depth_range_and_flags.z > 0.5;
    bool has_scene_depth = view_params.depth_range_and_flags.w > 0.5;

    // Opt9 work-stealing loop: each workgroup atomically claims one tile at a
    // time from steal_counter until all tiles are consumed.  Workgroups that
    // finish light tiles immediately claim the next one, preventing SM idle
    // time from load imbalance.
    while (true) {
        // Thread 0 claims the next tile; result broadcast via shared memory.
        if (local_index == 0u) {
            s_stolen_tile = atomicAdd(steal_counter, 1u);
        }
        barrier();

        uint tile_index = s_stolen_tile;
        if (tile_index >= morton_range) break;  // uniform: all threads exit

        // Decode Morton Z-curve code to 2D tile coordinates.
        // x occupies even bit positions, y occupies odd bit positions.
        uvec2 tile = MortonDecode2D(tile_index);

        // Skip Morton codes that fall outside the tile grid.
        // For non-power-of-2 grids the Morton square is larger than the tile
        // grid; these holes are skipped with no per-pixel work (uniform).
        if (tile.x >= tile_count_2d.x || tile.y >= tile_count_2d.y) {
            continue;
        }

        // Convert 2D tile back to linear (row-major) index used by the sort
        // keys.  tile_index is the Morton steal counter, NOT the sort-key
        // tile field — they differ for any non-trivial tile ordering.
        uint linear_tile = tile.y * tile_count_2d.x + tile.x;

        // Map this invocation to its pixel within the stolen tile.
        // local_index encodes (lx, ly) for the 16×16 workgroup.
        uvec2 local_2d = uvec2(local_index % 16u, local_index / 16u);
        ivec2 pixel = ivec2(tile * tile_size + local_2d);
        // Out-of-viewport pixels still participate in barrier() calls.
        bool pixel_active =
                (pixel.x < viewport_size.x && pixel.y < viewport_size.y);

        // Thread 0: binary search on sorted keys to find this tile's range.
        // Sort keys encode the linear tile index in their upper T bits, so
        // use linear_tile (not the Morton code tile_index) for the search.
        // The second search starts from tile_start, reducing its iteration
        // count from O(log₂ N) to O(log₂ tile_entry_count).
        if (local_index == 0u) {
            uint tile_start = LowerBound(linear_tile, 0u, N, D);
            uint tile_end = LowerBound(linear_tile + 1u, tile_start, N, D);
            wg_tile_offset = tile_start;
            wg_tile_count = tile_end - tile_start;
            wg_active_count = BATCH_SIZE;
        }
        barrier();

        uint my_tile_count = wg_tile_count;
        uint my_tile_offset = wg_tile_offset;

        // Per-pixel state — reset for each stolen tile.
        vec3 accum_color = vec3(0.0);
        float transmittance = 1.0;
        // Output depth in normalized linear convention (near=0, far=1);
        // converted back to Filament inverse convention before imageStore.
        // Initialise to 1.0 (far plane) so pixels with no splat contribution
        // produce inverse depth 0.0 (far), allowing the depth-merge shader to
        // pick the Filament scene depth via max(gs_inv=0, sc_inv).
        float out_norm_depth = 1.0;
        bool depth_written = false;
        bool opaque_anchor_found = false;
        uint opaque_anchor_index = 0u;
        float opaque_anchor_depth = 0.0;
        float coverage_transmittance = 1.0;
        vec2 pixel_center = vec2(pixel) + vec2(0.5);
        // Ordinary and reconstructed surfaces use the same per-pixel headlight.
        vec3 ray = SurfaceViewRay(pixel_center, viewport_size);

        // Convert Filament scene depth (inverse, near=1, far=0) to linear_01
        // once per pixel before the splat loop, so the per-splat occlusion
        // test is a simple float comparison with no per-iteration conversion.
        float scene_linear_01 = 1.0;  // far plane (no occlusion)
        bool use_scene_depth = has_scene_depth && pixel_active;
        if (use_scene_depth) {
            float scene_inverse_depth = texelFetch(scene_depth, pixel, 0).r;
            scene_linear_01 = InverseToLinear01(scene_inverse_depth, near, far);
        }

        // Keep only the nearest eight unprocessed hits per scan, not a cap on
        // contributing surfels. Repeat until exhausted or opacity saturates.
        // The (depth, splat ID) cursor gives deterministic ties and progress.
        const uint HIT_BATCH = 8u;
        // First select solid coverage. Only pixels below that threshold need
        // a second traversal: preserve their faint support instead of forcing
        // it opaque or deleting it. Ordinary transparency keeps its exact order.
        for (uint surface_pass = 0u; surface_pass < 2u; ++surface_pass) {
            if (surface_pass == 1u) {
                pixel_active = !opaque_anchor_found && coverage_transmittance < 1.0;
                if (pixel_active) {
                    accum_color = vec3(0.0);
                    transmittance = 1.0;
                    out_norm_depth = 1.0;
                    depth_written = false;
                }
                if (local_index == 0u) wg_active_count = 0u;
                barrier();
                uint weak_lanes = subgroupAdd(pixel_active ? 1u : 0u);
                if (subgroupElect() && weak_lanes > 0u) {
                    atomicAdd(wg_active_count, weak_lanes);
                }
                barrier();
                if (wg_active_count == 0u) break;
            }
            float last_depth = -1.0;
            uint last_id = 0u;
            while (true) {
                float hit_depth[HIT_BATCH];
                float hit_alpha[HIT_BATCH];
                uint hit_index[HIT_BATCH];
                uint kept = 0u;
                // Scan every tile candidate before blending any hit. Inactive
                // pixels skip intersection work but still load and synchronize;
                // all lanes traverse the same batches and continuation rounds.
                for (uint batch_start = 0u; batch_start < my_tile_count;
                     batch_start += BATCH_SIZE) {
                    uint batch_end = min(batch_start + BATCH_SIZE, my_tile_count);
                    uint batch_count = batch_end - batch_start;

                    // Cooperative load: each thread loads one 104 B ProjectedComposite
                    // from a single SSBO (binding 6).
                    if (local_index < batch_count) {
                        LoadCandidate(my_tile_offset + batch_start, local_index);
                    }
                    barrier();

                    // Per-pixel evaluation from shared memory.
                    // Skip if this pixel is outside the viewport or already saturated.
                    if (pixel_active) {
                        for (uint i = 0u; i < batch_count; ++i) {
                            float linear_depth, alpha;
                            if (!EvaluateCandidate(i, pixel_center, use_scene_depth,
                                                   scene_linear_01, near, far,
                                                   linear_depth, alpha)) continue;
                            uint hit_id = s_index[i];
                            if (linear_depth < last_depth ||
                                (linear_depth == last_depth && hit_id <= last_id)) {
                                continue;
                            }
                            uint at = kept;
                            for (uint j = 0u; j < kept; ++j) {
                                if (linear_depth < hit_depth[j] ||
                                    (linear_depth == hit_depth[j] && hit_id < hit_index[j])) {
                                    at = j;
                                    break;
                                }
                            }
                            if (at < HIT_BATCH) {
                                uint stop = min(kept, HIT_BATCH - 1u);
                                for (uint j = stop; j > at; --j) {
                                    hit_depth[j] = hit_depth[j - 1u];
                                    hit_alpha[j] = hit_alpha[j - 1u];
                                    hit_index[j] = hit_index[j - 1u];
                                }
                                hit_depth[at] = linear_depth;
                                hit_alpha[at] = alpha;
                                hit_index[at] = hit_id;
                                kept = min(kept + 1u, HIT_BATCH);
                            }
                        }
                    }
                    barrier();
                }  // scan every tile entry before compositing any selected hit
                vec3 weak_normal[HIT_BATCH];
                vec3 weak_color[HIT_BATCH];
                float weak_weight[HIT_BATCH];
                if (surface_pass == 1u) {
                    for (uint j = 0u; j < HIT_BATCH; ++j) {
                        weak_normal[j] = vec3(0.0);
                        weak_color[j] = vec3(0.0);
                        weak_weight[j] = 0.0;
                    }
                    // A single cooperative scan reconstructs all selected hits.
                    // Only subthreshold pixels pay for this exact-depth replay.
                    for (uint start = 0u; start < my_tile_count; start += BATCH_SIZE) {
                        uint count = min(BATCH_SIZE, my_tile_count - start);
                        if (local_index < count) {
                            LoadCandidate(my_tile_offset + start, local_index);
                        }
                        barrier();
                        if (pixel_active) {
                            for (uint i = 0u; i < count; ++i) {
                                if ((s_flags[i] & 1u) == 0u) continue;
                                float depth, weight;
                                if (!EvaluateCandidate(i, pixel_center, use_scene_depth,
                                                       scene_linear_01, near, far,
                                                       depth, weight)) continue;
                                ProjectedComposite candidate = composite[s_index[i]];
                                for (uint j = 0u; j < kept; ++j) {
                                    ProjectedComposite anchor = composite[hit_index[j]];
                                    if ((anchor.surface_flags & 1u) == 0u) continue;
                                    AccumulateSurface(anchor, hit_depth[j], candidate,
                                                      depth, weight, ray,
                                                      weak_normal[j], weak_color[j],
                                                      weak_weight[j]);
                                }
                            }
                        }
                        barrier();
                    }
                }
                if (pixel_active) {
                    for (uint j = 0u; j < kept; ++j) {
                        if (surface_pass == 0u &&
                            (composite[hit_index[j]].surface_flags & 1u) != 0u) {
                            // Reference coverage is geometric Gaussian support,
                            // with fixed reference opacity shared by all splats.
                            float reference_alpha = clamp(0.99 * hit_alpha[j], 0.0, 0.99);
                            coverage_transmittance *= 1.0 - reference_alpha;
                            if (coverage_transmittance < 0.5) {
                                opaque_anchor_found = true;
                                opaque_anchor_index = hit_index[j];
                                opaque_anchor_depth = hit_depth[j];
                                // Foreground transparency may already have
                                // crossed the existing depth threshold. Keep
                                // that nearer hit; shading never moves depth.
                                if (!depth_written) {
                                    out_norm_depth = (hit_depth[j] - near) / (far - near);
                                    depth_written = true;
                                }
                                pixel_active = false;
                                break;
                            }
                            last_depth = hit_depth[j];
                            last_id = hit_index[j];
                            continue;
                        }
                        float alpha = hit_alpha[j];
                        ProjectedComposite hit = composite[hit_index[j]];
                        vec3 shaded;
                        if (surface_pass == 1u &&
                            (hit.surface_flags & 1u) != 0u) {
                            alpha = clamp(0.99 * hit_alpha[j], 0.0, 0.99);
                            shaded = ShadeSurface(weak_normal[j], weak_color[j],
                                                  weak_weight[j], ray);
                        } else {
                            shaded = ShadeSurface(
                                    vec3(hit.surface_normal_xy,
                                         hit.surface_normal_z_sigma.x),
                                    vec3(hit.surface_color_rg,
                                         hit.surface_color_b_reserved.x),
                                    1.0, ray);
                        }
                        float contribution = transmittance * alpha;
                        accum_color += contribution * shaded;
                        transmittance *= (1.0 - alpha);
                        if (!depth_written && transmittance < kSurfaceThreshold) {
                            out_norm_depth = (hit_depth[j] - near) / (far - near);
                            depth_written = true;
                        }
                        last_depth = hit_depth[j];
                        last_id = hit_index[j];
                        if (transmittance <= kMinTransmittance) {
                            transmittance = 0.0;
                            pixel_active = false;
                            break;
                        }
                    }
                    // Fewer than eight means this scan found every remaining hit.
                    // A full batch continues from its final (depth, ID) next round.
                    if (kept < HIT_BATCH) pixel_active = false;
                }
                // All invocations reach both barriers, including inactive pixels.
                if (local_index == 0u) wg_active_count = 0u;
                barrier();
                uint lanes_active = subgroupAdd(pixel_active ? 1u : 0u);
                if (subgroupElect() && lanes_active > 0u) {
                    atomicAdd(wg_active_count, lanes_active);
                }
                barrier();
                if (wg_active_count == 0u) break;
            }
        }

        // Reconstruct the coverage-selected surface without interpolation-
        // weight termination or a contributor cap. Coverage chooses identity;
        // normalized weights shade only that identity. Keep actual selected
        // hit depth, never averaged depth or a GS-center approximation.
        bool gather_any = false;
        if (local_index == 0u) wg_active_count = 0u;
        barrier();
        uint anchor_lanes = subgroupAdd(opaque_anchor_found ? 1u : 0u);
        if (subgroupElect() && anchor_lanes > 0u) {
            atomicAdd(wg_active_count, anchor_lanes);
        }
        barrier();
        gather_any = wg_active_count > 0u;
        if (gather_any) {
            ProjectedComposite anchor = composite[opaque_anchor_index];
            vec3 normal_sum = vec3(0.0);
            vec3 color_sum = vec3(0.0);
            float weight_sum = 0.0;
            for (uint start = 0u; start < my_tile_count; start += BATCH_SIZE) {
                uint count = min(BATCH_SIZE, my_tile_count - start);
                if (local_index < count) {
                    LoadCandidate(my_tile_offset + start, local_index);
                }
                barrier();
                if (opaque_anchor_found) {
                    for (uint i = 0u; i < count; ++i) {
                        if ((s_flags[i] & 1u) == 0u) continue;
                        ProjectedComposite candidate = composite[s_index[i]];
                        float depth, weight;
                        if (!EvaluateCandidate(i, pixel_center, use_scene_depth,
                                               scene_linear_01, near, far,
                                               depth, weight)) continue;
                        AccumulateSurface(anchor, opaque_anchor_depth, candidate,
                                          depth, weight, ray, normal_sum, color_sum,
                                          weight_sum);
                    }
                }
                barrier();
            }
            if (opaque_anchor_found && weight_sum > 0.0) {
                vec3 shaded = ShadeSurface(normal_sum, color_sum,
                                           weight_sum, ray);
                accum_color += transmittance * shaded;
                transmittance = 0.0;
            }
        }

        // Write outputs for pixels that are inside the viewport.
        if (pixel.x < viewport_size.x && pixel.y < viewport_size.y) {
            float out_alpha = 1.0 - transmittance;
            // accum_color is already premultiplied by construction:
            //   each splat contributes transmittance * alpha * color.
            // Vulkan renders meshes into out_color before this pass. Metal
            // renders splats into a separate transparent overlay that the UI
            // composites over Filament's mesh color.
            vec4 out_color_value = vec4(accum_color, out_alpha);
            if (composite_over_base) {
                vec4 base_color = imageLoad(out_color, pixel);
                out_color_value =
                        vec4(accum_color + base_color.rgb * transmittance,
                             out_alpha + base_color.a * transmittance);
            }
            imageStore(out_color, pixel, out_color_value);
            // Convert nearest-splat depth back to Filament inverse convention
            // (near=1, far=0) so gaussian_depth_merge.comp and CPU readback
            // can compare against Filament's own depth buffer unchanged.
            float out_inverse_depth =
                    depth_written ? Linear01ToInverse(out_norm_depth, near, far)
                                  : 0.0;
            imageStore(out_depth, pixel,
                       vec4(out_inverse_depth, 0.0, 0.0, 0.0));
        }
    }  // work-stealing loop: grab next tile
}
